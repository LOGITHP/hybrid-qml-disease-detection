# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# MongoDB / Beanie (the active database implementation)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=hybrid_qml_db

# Optional infrastructure used by the Compose stack
REDIS_URL=redis://localhost:6379/0
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Local artifact files (uploaded CSVs, preprocessing runs, trained models)
ARTIFACT_ROOT=./artifacts

# Authentication: replace this with a private random value of at least 32 bytes.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# The current agent client expects a Gemma-compatible POST /generate endpoint.
# If it is unreachable, preprocessing planning uses its deterministic fallback text.
LLM_PROVIDER=gemma
LLM_BASE_URL=http://localhost:8001
